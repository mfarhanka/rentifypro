<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalize public URLs back to the project root.
    RewriteCond %{THE_REQUEST} \s/+(.*/)?public(?:[/?#\s]|$) [NC]
    RewriteRule ^public/?(.*)$ /rentifypro/$1 [R=301,L]

    # Route application requests through the public front controller.
    RewriteCond %{REQUEST_URI} !^/rentifypro/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
